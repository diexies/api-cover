    <PackageId>APICover.Agent</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APICover\APICover.csproj" />
    <ProjectReference Include="..\APICover.Abstractions\APICover.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="APICover.Agent.Tests" />
    <InternalsVisibleTo Include="APICover.Agent.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\INTRODUCE.md" />
  </ItemGroup>

</Project>
